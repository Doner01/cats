{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "buildCommand": "python build_vercel.py",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=3600"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    }
  ]
}
