# Supabase Configuration (Database & Auth)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Flask Application Secret Key
SECRET_KEY=generate-a-secure-random-key-here

# Administrator Emails (Comma-separated for multiple admins)
ADMIN_EMAIL=programmer.doner2006@gmail.com
ADMIN_EMAILS=programmer.doner2006@gmail.com

# Cloudflare R2 Object Storage (Optional - Ultra-fast global 10GB free storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=cat-images
R2_PUBLIC_DOMAIN=https://pub-xxxxxx.r2.dev
