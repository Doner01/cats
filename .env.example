# CatRank Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — production secrets belong in your hosting provider's dashboard.

# --- Required ---
PUBLIC_SITE_URL=https://your-domain.example.com
APP_ENV=development
SECRET_KEY=generate-a-random-32-char-string-here

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Comma-separated emails that get admin access
ADMIN_EMAILS=admin@example.com

# --- Storage (Cloudflare R2) ---
# Set all four or leave all empty to use Supabase Storage as fallback
R2_ACCOUNT_ID=
R2_BUCKET_NAME=cat-images
R2_PUBLIC_DOMAIN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Rate Limiting ---
# Use Redis for multi-worker deployments; memory:// for single-worker dev
RATE_LIMIT_STORAGE_URI=memory://
TRUST_PROXY_HOPS=0

# --- Feature Flags ---
FLASK_DEBUG=false
ENABLE_DEMO_DATA=false
GOOGLE_AUTH_ENABLED=false
PHONE_AUTH_ENABLED=false
COUNTRY_ACCESS_ENABLED=false

# --- Server ---
PORT=5000
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
